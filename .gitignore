.DS_Store
.env
.env.*
!.env.example
secrets/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
# the local CSV fallback output; root only, because evals/data is committed
/data/
*.pdf
*.docx
*.egg-info/

# personal data: must never be committed (project must be open-sourceable)
config/master_resume.yaml
config/answers.yaml

# generated documents contain personal data
output/

# personal filter rules (may name the companies you target); a generic example is committed
config/criteria.local.yaml

# your own identifiers/targets, read only by local tests so the public guards do not leak them
config/private_terms.txt

# personal assistant instructions (preferences and background); a public CLAUDE.md is committed
CLAUDE.local.md
