# Copy to .env (git-ignored) and fill in.

# Path to the service account key file (local runs)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
# Or the raw JSON contents (GitHub Actions secret); takes precedence if set
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Drive uses OAuth as you (service accounts have no Drive quota). Run `jobagent auth-drive` once.
GOOGLE_OAUTH_CLIENT_FILE=secrets/oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/drive-token.json
# GitHub Actions secret: contents of the token file; takes precedence if set
# GOOGLE_OAUTH_TOKEN_JSON=

# From the Sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=
# From the Drive folder URL: https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=

# "sheets" or "csv" (local fallback)
STORAGE_BACKEND=sheets

# Paid-tier key from console.anthropic.com (no training on your data). Never commit it.
ANTHROPIC_API_KEY=

# Google AI Studio key. The free tier is allowed ONLY for agents that see public data (Onboarding).
GEMINI_API_KEY=

# CI only: the full text of config/master_resume.yaml (stored as a GitHub secret, never committed).
# MASTER_RESUME_YAML=
